  pop_tud_swl -> pop_cbc_swl
  pop_tud_swl -> excl_cbc_swl

  pop_cbc_swl -> pop_work_swl
  pop_cbc_swl -> excl_work_swl

  pop_work_swl -> pop_covid_swl
  pop_work_swl -> excl_covid_swl
  
}
