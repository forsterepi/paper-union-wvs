  pop_mem -> excl_occ

  pop_occ -> pop_empl
  pop_occ -> excl_empl

  pop_empl -> pop_gender
  pop_empl -> excl_gender
  
  pop_gender -> pop_srh
  pop_gender -> pop_swl
  
  pop_srh -> pop_tud_srh
