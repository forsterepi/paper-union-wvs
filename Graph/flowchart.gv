  pop_work_swl [label = "Working population\n n = @@22", shape = box]

  pop_covid_srh [label = "Before 2020\n n = @@24", shape = box]
  pop_covid_swl [label = "Before 2020\n n = @@26", shape = box]

  pop_domrep_srh [label = "Exclude DomRep\n n = @@28", shape = box]

  excl_mem [label = "Exclude\n n = @@3"]
