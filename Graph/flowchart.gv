  excl_empl [label = "Exclude\n n = @@7"]
  excl_gender [label = "Exclude\n n = @@9"]
  excl_tud_srh [label = "Exclude\n n = @@13"]
  excl_cbc_srh [label = "Exclude\n n = @@15"]
  excl_tud_swl [label = "Exclude\n n = @@17"]
  excl_cbc_swl [label = "Exclude\n n = @@19"]
